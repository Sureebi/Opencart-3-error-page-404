{{ header }}
{% set ph404_en = code == 'en' %}
<style>
#poshub-404 { padding: 30px 0 55px; color: #202124; }
#poshub-404 * { box-sizing: border-box; }
#poshub-404 .ph404-card { display: flex; align-items: center; gap: 24px; padding: 44px 32px; background: #fff; border: 1px solid #eee; border-radius: 20px; box-shadow: 0 12px 40px rgba(25,25,25,.045); }
#poshub-404 .ph404-art { position: relative; isolation: isolate; flex: 1 1 44%; min-width: 0; }
#poshub-404 .ph404-art::before { content: ""; position: absolute; z-index: -1; width: 94%; height: 57%; max-width: 350px; left: 49%; top: 55%; transform: translate(-50%, -50%) rotate(-28deg); border-radius: 72% 28% 64% 36% / 38% 62% 38% 62%; background: #fff4e3; }
#poshub-404 .ph404-art img { display: block; width: 100%; height: auto; max-width: 390px; margin: auto; }
#poshub-404 .ph404-copy { flex: 1 1 56%; min-width: 0; }
#poshub-404 .ph404-number { display: flex; color: #202124; font-size: clamp(90px,10vw,142px); line-height: .95; font-weight: 800; letter-spacing: -7px; margin: 0 0 22px; }
#poshub-404 .ph404-number span { color: #f59a16; }
#poshub-404 .ph404-title { color: #202124; font-size: 27px; line-height: 1.28; font-weight: 700; margin: 0 0 16px; text-transform: none; }
#poshub-404 .ph404-description { color: #62666c; font-size: 15px; line-height: 1.8; margin: 0 0 25px; }
#poshub-404 .ph404-actions { display: flex; flex-wrap: wrap; gap: 12px; }
#poshub-404 .ph404-button { display: inline-flex; align-items: center; justify-content: center; gap: 9px; min-height: 46px; padding: 12px 22px; border: 1px solid #f59a16; border-radius: 7px; background: #f59a16; color: #202124; font-size: 14px; font-weight: 700; line-height: 1.4; text-decoration: none; transition: background-color .18s ease, border-color .18s ease; }
#poshub-404 .ph404-button svg { width: 17px; height: 17px; flex-shrink: 0; }
#poshub-404 .ph404-button-secondary { background: #fff; border-color: #d9dce0; }
#poshub-404 .ph404-button:hover { background: #ffb43e; border-color: #ffb43e; }
#poshub-404 .ph404-button-secondary:hover { background: #f5f5f5; border-color: #a8acb0; }
#poshub-404 a:focus-visible { outline: 3px solid #202124; outline-offset: 4px; }
#poshub-404 .ph404-support { margin-top: 28px; padding-top: 22px; border-top: 1px solid #eee; color: #62666c; font-size: 13px; line-height: 1.8; }
#poshub-404 .ph404-support p { margin: 0 0 5px; }
#poshub-404 .ph404-contacts { display: flex; flex-wrap: wrap; gap: 4px 16px; }
#poshub-404 .ph404-contacts a { color: #34373b; text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; }
@media (max-width: 1199px) { #poshub-404 .ph404-card { padding: 32px 22px; gap: 16px; } #poshub-404 .ph404-title { font-size: 24px; } }
@media (max-width: 991px) { #poshub-404 .ph404-card { flex-direction: column; text-align: center; } #poshub-404 .ph404-art { width: 100%; } #poshub-404 .ph404-art img { max-width: 270px; } #poshub-404 .ph404-number, #poshub-404 .ph404-actions, #poshub-404 .ph404-contacts { justify-content: center; } #poshub-404 .ph404-number { font-size: 108px; } }
@media (max-width: 480px) { #poshub-404 { padding: 18px 0 32px; } #poshub-404 .ph404-card { padding: 24px 18px; border-radius: 14px; } #poshub-404 .ph404-art img { max-width: 240px; } #poshub-404 .ph404-title { font-size: 23px; } #poshub-404 .ph404-button { flex: 1 1 auto; } }
@media (prefers-reduced-motion: reduce) { #poshub-404 .ph404-button { transition: none; } }
</style>
<div id="error-not-found" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  <div class="row">
    {{ column_left }}
    {% if column_left and column_right %}
      {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
      {% set class = 'col-sm-9' %}
    {% else %}
      {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">
      {{ content_top }}
      <section id="poshub-404" aria-labelledby="ph404-title">
        <div class="ph404-card">
          <div class="ph404-art" aria-hidden="true">
            <img src="data:image/png;base64," width="1271" height="1237" alt="" decoding="async">
          </div>
          <div class="ph404-copy">
            <div class="ph404-number" aria-hidden="true">4<span>0</span>4</div>
            <div id="ph404-title" class="ph404-title" role="heading" aria-level="1">{{ ph404_en ? 'Looking for deals here too?' : 'И тук ли проверихте за промоции?' }}</div>
            <p class="ph404-description">{{ ph404_en ? 'We like persistent shoppers. But even we have nothing to sell you here — just a 404. Our categories are a lot more useful.' : 'Харесваме упорити клиенти. Но тук дори ние нямаме какво да ви продадем — само едно 404. В категориите сме доста по-полезни.' }}</p>
            <div class="ph404-actions">
              <a href="{{ continue }}" class="ph404-button">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m3 10 9-7 9 7M5 9v12h5v-7h4v7h5V9" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {{ ph404_en ? 'Go to store' : 'Към магазина' }}
              </a>
              <a href="index.php?route=information/sitemap" class="ph404-button ph404-button-secondary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                {{ ph404_en ? 'Show categories' : 'Покажи категории' }}
              </a>
            </div>
            <div class="ph404-support">
              <p>{{ ph404_en ? 'What you’re looking for isn’t here. Try browsing our categories.' : 'Тук няма това, което търсите. Разгледайте нашите категории.' }}</p>
            </div>
          </div>
        </div>
      </section>
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>
{{ footer }}
